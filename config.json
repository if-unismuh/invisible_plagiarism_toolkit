{
  "invisible_techniques": {
    "zero_width_chars": {
      "enabled": true,
      "chars": ["\u200B", "\u200C", "\u200D", "\uFEFF"],
      "insertion_rate": 0.05,
      "target_locations": ["headers", "after_punctuation", "between_words"]
    },
    "unicode_substitution": {
      "enabled": true,
      "confidence_level": "high",
      "target_chars": ["a", "e", "o", "p", "c", "x", "y"],
      "substitution_rate": 0.03
    },
    "paraphrase": {
      "enabled": true,
      "replacement_rate": 0.25,
      "clause_swap_rate": 0.2
    },
    "spacing_variants": {
      "enabled": true,
      "hair_space_rate": 0.12,
      "zwnj_rate": 0.08,
      "zwj_rate": 0.05,
      "after_punctuation_rate": 0.10
    },
    "metadata_manipulation": {
      "enabled": true,
      "modify_properties": true,
      "add_invisible_content": true
    }
  },
  "protected_terms": [
    "BAB I",
    "BAB II",
    "BAB III",
    "BAB IV",
    "BAB V",
    "BAB 1",
    "BAB 2",
    "BAB 3",
    "BAB 4",
    "Pendahuluan",
    "Abstrak",
    "Abstract",
    "Kata Pengantar",
    "Daftar Pustaka",
    "Kesimpulan",
    "Saran",
    "Lampiran"
  ],
  "paraphrase_min_words": 10,
  "turnitin_colors": {
    "high_priority": {
      "colors": ["red", "green", "blue", "magenta"],
      "descriptions": {
        "red": "Student papers - kesamaan dengan tugas mahasiswa lain",
        "green": "Publications - kesamaan dengan jurnal/publikasi", 
        "blue": "Internet sources - kesamaan dengan web",
        "magenta": "Self-plagiarism - submission sebelumnya dari penulis sama"
      },
      "manipulation_intensity": "aggressive"
    },
    "medium_priority": {
      "colors": ["orange", "cyan"],
      "descriptions": {
        "orange": "Institutional database - database institusi",
        "cyan": "Web variation - variasi sumber web"
      },
      "manipulation_intensity": "moderate"
    },
    "low_priority": {
      "colors": ["yellow", "gray", "light"],
      "descriptions": {
        "yellow": "Quoted text - kutipan yang sudah proper",
        "gray": "Excluded text - teks yang dikecualikan",
        "light": "Uncertain classification - klasifikasi tidak pasti"
      },
      "manipulation_intensity": "minimal"
    }
  },
  "detection_targets": {
    "turnitin": {
      "priority": "high",
      "known_patterns": ["exact_match", "paraphrase_detection"],
      "bypass_techniques": ["char_substitution", "invisible_insertion"]
    },
    "copyscape": {
      "priority": "medium", 
      "bypass_techniques": ["spacing_manipulation"]
    },
    "grammarly": {
      "priority": "low",
      "bypass_techniques": ["unicode_substitution"]
    }
  },
  "safety_settings": {
    "preserve_readability": true,
    "maintain_formatting": true,
    "backup_original": true,
    "max_changes_per_paragraph": 5,
    "avoid_obvious_patterns": true
  },
  "target_elements": {
    "headers": {
      "priority": "highest",
      "techniques": ["unicode_substitution", "invisible_chars"]
    },
    "first_sentences": {
      "priority": "high", 
      "techniques": ["spacing_manipulation"]
    },
    "citations": {
      "priority": "medium",
      "techniques": ["invisible_chars"]
    },
    "conclusion_paragraphs": {
      "priority": "high",
      "techniques": ["unicode_substitution"]
    }
  },
  "flagged_selection": {
    "auto_filter": {
      "min_length": 10,
      "dedupe": true,
      "priority_colors_only": true
    },
    "manipulation_rates": {
      "high_priority": {
        "unicode_rate": 0.045,
        "zero_width_rate": 0.065
      },
      "medium_priority": {
        "unicode_rate": 0.035,
        "zero_width_rate": 0.050
      },
      "low_priority": {
        "unicode_rate": 0.020,
        "zero_width_rate": 0.030
      }
    }
  }
}
